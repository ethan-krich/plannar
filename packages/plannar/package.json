    "lucide-react": "catalog:",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "catalog:",
    "tailwindcss": "catalog:",
    "tw-animate-css": "catalog:",
    "vite": "catalog:"
  },
  "devDependencies": {
    "@types/node": "^25.6.2",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@typescript/native-preview": "7.0.0-dev.20260509.2",
