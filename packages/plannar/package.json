    "citty": "^0.2.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jiti": "^2.4.2",
    "lucide-react": "^1.16.0",
    "next-themes": "^0.4.6",
    "react": "^19.1.0",
