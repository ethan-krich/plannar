{
  "name": "plannar",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "ready": "vp check && vp run -r test && vp run -r build",
    "dev": "vp run editor#dev",
    "dev:site": "pnpm --filter @plannar/site dev",
    "prepare": "vp config",
    "postinstall": "cd packages/core && vp pack && cd ../.. && vp run --filter '!@plannar/core' build",
    "version": "changeset version",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "catalog:",
    "@plannar/core": "workspace:*",
    "@tailwindcss/vite": "^4.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@11.1.2"
}
